pkgname=fcitx5-candidate-translator
pkgver=0.1.0
pkgrel=1
pkgdesc='Translate Fcitx5 Shuangpin candidates with an OpenAI-compatible API'
arch=('x86_64')
url=''
license=('MIT')
depends=('fcitx5>=5.1.20' 'gcc-libs' 'glibc')
makedepends=('cargo' 'gcc' 'pkgconf')
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --release --locked
}

check() {
  cd "$startdir/.."
  cargo test --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/libfcitx5_candidate_translator.so \
    "$pkgdir/usr/lib/fcitx5/libfcitx5-candidate-translator.so"
  install -Dm644 data/candidate-translator.conf \
    "$pkgdir/usr/share/fcitx5/addon/candidate-translator.conf"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
